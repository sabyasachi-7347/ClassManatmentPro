rules_version = '2';

// All reads and writes go through the NestJS API (Admin SDK bypasses these rules).
// Clients never talk to Firestore directly, so lock everything down.
// If you later want realtime listeners in the apps, open narrow read rules here
// based on the custom claims the API sets: request.auth.token.instituteId / .role.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
