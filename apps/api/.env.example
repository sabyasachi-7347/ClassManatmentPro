# ---- Server ----
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Firebase ----
FIREBASE_PROJECT_ID=demo-classes-os

# Option A (recommended in prod): path to a service-account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Option B: inline service account (useful for PaaS). Escape newlines as \n
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Option C (local dev): use the Firebase emulators — no credentials needed
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
