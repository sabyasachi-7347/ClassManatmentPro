# Base URL of the NestJS API. Leave as /api/v1 in dev (Vite proxies it).
VITE_API_URL=/api/v1

# Firebase web app config — Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-classes-os
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Auth emulator (npm run emulators)
VITE_USE_EMULATORS=true
